<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crate — Admin</title>


<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
  rel="stylesheet"
/>

<style>
  :root {
    --pine: #1f3a2e;
    --pine-dark: #14261d;
    --paper: #f2f5ef;
    --card: #ffffff;
    --ink: #1c231d;
    --ink-soft: #5c6b5e;
    --line: #dee4d9;
    --ember: #e4572e;
    --ember-dark: #c1431e;
    --gold: #c9860f;
    --gold-bg: #fbeedc;
    --brick: #a83a2e;
    --brick-dark: #8a2e24;
    --shadow-sm: 0 1px 2px rgba(20, 43, 33, 0.06);
    --shadow-md: 0 8px 24px rgba(20, 43, 33, 0.1);
    --radius: 12px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Inter", -apple-system, sans-serif;
    background: var(--paper);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: "Fraunces", serif;
    color: var(--pine-dark);
    margin: 0;
  }

  a {
    color: inherit;
  }

  /* Navbar */

  .navbar {
    background: var(--card);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .navbar-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--pine);
    color: #fff;
  }

  .brand-word {
    font-family: "Fraunces", serif;
    font-weight: 700;
    font-size: 21px;
    color: var(--pine-dark);
  }

  .brand-tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--gold-bg);
    color: var(--gold);
    padding: 3px 8px;
    border-radius: 20px;
    margin-left: 2px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .inline-form {
    margin: 0;
    display: inline;
  }

  /* Buttons */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 8px;
    border: 1.5px solid transparent;
    cursor: pointer;
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.1s ease;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn-sm {
    padding: 8px 14px;
    font-size: 13px;
  }

  .btn-primary {
    background: var(--ember);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--ember-dark);
  }

  .btn-dark {
    background: var(--pine);
    color: #fff;
  }

  .btn-dark:hover {
    background: var(--pine-dark);
  }

  .btn-outline {
    background: transparent;
    border-color: var(--line);
    color: var(--pine-dark);
  }

  .btn-outline:hover {
    border-color: var(--pine);
    background: var(--paper);
  }

  .btn-danger {
    background: transparent;
    border-color: var(--brick);
    color: var(--brick);
  }

  .btn-danger:hover {
    background: var(--brick);
    color: #fff;
  }

  .btn-danger-solid {
    background: var(--brick);
    color: #fff;
  }

  .btn-danger-solid:hover {
    background: var(--brick-dark);
  }

  .btn-block {
    width: 100%;
  }

  /* Page */

  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 24px 72px;
  }

  .page-head {
    margin-bottom: 32px;
  }

  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ember-dark);
    margin: 0 0 8px;
  }

  .page-head h1 {
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .page-sub {
    color: var(--ink-soft);
    margin: 0;
    font-size: 15px;
  }

  /* Product management cards */

  .management-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-bottom: 44px;
  }

  .listing-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 4px solid var(--ember);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: var(--shadow-sm);
  }

  .excel-card {
    border-top-color: var(--pine);
  }

  .listing-card h2 {
    font-size: 19px;
    margin-bottom: 4px;
  }

  .listing-card .page-sub {
    margin-bottom: 18px;
  }

  .field {
    margin-bottom: 16px;
  }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--pine-dark);
    margin-bottom: 6px;
  }

  .field input,
  .field select {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    font-family: "Inter", sans-serif;
    font-size: 15px;
    color: var(--ink);
    background: #fff;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: var(--pine);
    box-shadow: 0 0 0 3px rgba(31, 58, 46, 0.12);
  }

  .file-input {
    cursor: pointer;
  }

  .excel-info {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 18px;
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .excel-info strong {
    color: var(--pine-dark);
  }

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .category-item {
    background: var(--gold-bg);
    color: var(--gold);
    border-radius: 20px;
    padding: 4px 9px;
    font-size: 11px;
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
  }

  /* Product grid */

  .section-heading {
    font-size: 24px;
    margin-bottom: 20px;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px;
  }

  .product-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .price-tag {
    align-self: flex-start;
    background: var(--pine);
    color: #fff;
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    font-size: 13px;
    padding: 6px 14px 6px 22px;
    border-radius: 0 20px 20px 0;
    position: relative;
  }

  .price-tag::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 50%;
    width: 6px;
    height: 6px;
    background: var(--paper);
    border-radius: 50%;
    transform: translateY(-50%);
  }

  .product-name {
    font-size: 18px;
    font-weight: 600;
  }

  .product-desc {
    color: var(--ink-soft);
    font-size: 14px;
    margin: 0;
    min-height: 20px;
  }

  .stock-pill {
    align-self: flex-start;
    background: var(--gold-bg);
    color: var(--gold);
    font-family: "IBM Plex Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
  }

  .product-card form {
    margin-top: auto;
  }

  /* Empty state */

  .empty-state {
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    padding: 56px 24px;
    text-align: center;
  }

  .empty-state h2 {
    font-size: 22px;
    margin-bottom: 8px;
  }

  .empty-state p {
    color: var(--ink-soft);
    margin: 0;
  }

  /* Modals */

  .modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(20, 38, 29, 0.55);
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }

  .modal-card {
    width: 100%;
    max-width: 380px;
    background: var(--card);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 24px 48px rgba(20, 38, 29, 0.28);
  }

  .modal-card h2 {
    font-size: 20px;
    margin-bottom: 6px;
  }

  .modal-warn {
    color: var(--brick);
    font-size: 13.5px;
    margin: 0 0 18px;
  }

  .modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  @media (max-width: 760px) {
    .management-grid {
      grid-template-columns: 1fr;
    }

    .page {
      padding: 28px 16px 56px;
    }

    .navbar-inner {
      padding: 14px 16px;
    }

    .nav-actions {
      width: 100%;
    }
  }
</style>


  </head>

  <body>


<!-- =======================
     NAVBAR
======================== -->

<header class="navbar">
  <div class="navbar-inner">

    <div class="brand">
      <span class="brand-mark">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M3 9L5 4H19L21 9"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M3 9H21L19.5 20H4.5L3 9Z"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
          <path
            d="M8 9V4M12 9V4M16 9V4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </span>

      <span class="brand-word">Crate</span>
      <span class="brand-tag">Admin</span>
    </div>

    <nav class="nav-actions">

      <button
        type="button"
        class="btn btn-outline btn-sm"
        onclick="openPasswordModal()"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
        >
          <circle
            cx="8"
            cy="15"
            r="4"
            stroke="currentColor"
            stroke-width="1.8"
          />
          <path
            d="M11 12L20 3M20 3h-4M20 3v4"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        Update Password
      </button>

      <button
        type="button"
        class="btn btn-danger btn-sm"
        onclick="openDeleteModal()"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M4 7H20M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-8 0l1 13a2 2 0 002 2h4a2 2 0 002-2l1-13"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        Delete Account
      </button>

      <form action="/logout" method="POST" class="inline-form">
        <button type="submit" class="btn btn-outline btn-sm">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="M9 4H6a2 2 0 00-2 2v12a2 2 0 002 2h3M16 16l4-4-4-4M20 12H9"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

          Logout
        </button>
      </form>

    </nav>
  </div>
</header>


<!-- =======================
     PAGE
======================== -->

<main class="page">

  <div class="page-head">
    <p class="eyebrow">
      Hello, <%= user.name %>
    </p>

    <h1>Store management</h1>

    <p class="page-sub">
      Add products manually or import multiple products using Excel.
    </p>
  </div>


  <!-- =======================
       PRODUCT MANAGEMENT
  ======================== -->

  <div class="management-grid">


    <!-- =======================
         MANUAL PRODUCT
    ======================== -->

    <div class="listing-card">

      <h2>Add Product Manually</h2>

      <p class="page-sub">
        Add a single product to your inventory.
      </p>

      <form action="/add/product" method="POST">

        <div class="field">
          <label>Product Name</label>

          <input
            type="text"
            name="name"
            placeholder="Enter product name"
            required
          />
        </div>


        <div class="field">
          <label>Product Price</label>

          <input
            type="number"
            name="price"
            placeholder="Enter price"
            min="0"
            step="0.01"
            required
          />
        </div>


        <div class="field">
          <label>Description</label>

          <input
            type="text"
            name="description"
            placeholder="Enter product description"
          />
        </div>


        <div class="field">
          <label>Quantity</label>

          <input
            type="number"
            name="quantity"
            placeholder="Enter quantity"
            min="0"
            required
          />
        </div>


        <div class="field">
          <label>Category</label>

          <select name="category" required>

            <option value="" disabled selected>
              Select a category
            </option>

            <option value="Electronics">
              Electronics
            </option>

            <option value="Clothing">
              Clothing
            </option>

            <option value="Home & Kitchen">
              Home & Kitchen
            </option>

            <option value="Books">
              Books
            </option>

            <option value="Beauty">
              Beauty
            </option>

            <option value="Sports">
              Sports
            </option>

            <option value="Other">
              Other
            </option>

          </select>
        </div>


        <button
          type="submit"
          class="btn btn-primary btn-block"
        >
          Add Product
        </button>

      </form>

    </div>


    <!-- =======================
         EXCEL IMPORT
    ======================== -->

    <div class="listing-card excel-card">

      <h2>Import Products from Excel</h2>

      <p class="page-sub">
        Add multiple products at once using an Excel file.
      </p>


      <div class="excel-info">

        <strong>Excel format:</strong>

        Your Excel file must contain these columns:

        <div class="category-list">

          <span class="category-item">
            Product Name
          </span>

          <span class="category-item">
            Price
          </span>

          <span class="category-item">
            Description
          </span>

          <span class="category-item">
            Quantity
          </span>

          <span class="category-item">
            Category
          </span>

        </div>

      </div>


      <form
        action="/profile"
        method="POST"
        enctype="multipart/form-data"
      >

        <div class="field">

          <label>
            Select Excel File
          </label>

          <input
            type="file"
            name="excel"
            class="file-input"
            accept=".xlsx,.xls"
            required
          />

        </div>


        <div class="excel-info">

          <strong>Allowed categories:</strong>

          <div class="category-list">

            <span class="category-item">
              Electronics
            </span>

            <span class="category-item">
              Clothing
            </span>

            <span class="category-item">
              Home & Kitchen
            </span>

            <span class="category-item">
              Books
            </span>

            <span class="category-item">
              Beauty
            </span>

            <span class="category-item">
              Sports
            </span>

            <span class="category-item">
              Other
            </span>

          </div>

        </div>


        <button
          type="submit"
          class="btn btn-dark btn-block"
        >
          Upload Excel
        </button>

      </form>

    </div>

  </div>


  <!-- =======================
       PRODUCTS
  ======================== -->

  <h2 class="section-heading">
    Products
  </h2>


  <% if (products.length === 0) { %>

    <div class="empty-state">

      <h2>
        No products listed yet
      </h2>

      <p>
        Add your first item above to start stocking the shelves.
      </p>

    </div>

  <% } else { %>

    <div class="product-grid">

      <% products.forEach((product) => { %>

        <article class="product-card">

          <span class="price-tag">
            ₹<%= product.product_price %>
          </span>


          <h3 class="product-name">
            <%= product.product_name %>
          </h3>


          <p class="product-desc">
            <%= product.description %>
          </p>


          <% if (product.category) { %>

            <span class="stock-pill">
              <%= product.category %>
            </span>

          <% } %>


          <span class="stock-pill">
            <%= product.quantity %> in stock
          </span>


          <form
            action="/delete/product"
            method="POST"
          >

            <input
              type="hidden"
              name="productId"
              value="<%= product.ID %>"
            />

            <button
              type="submit"
              class="btn btn-danger-solid btn-block"
            >
              Delete Product
            </button>

          </form>

        </article>

      <% }) %>

    </div>

  <% } %>

</main>


<!-- =======================
     UPDATE PASSWORD MODAL
======================== -->

<div
  id="passwordModal"
  class="modal-backdrop"
>

  <div class="modal-card">

    <h2>
      Update Password
    </h2>

    <p
      class="page-sub"
      style="margin-bottom: 18px;"
    >
      Confirm your current password to set a new one.
    </p>


    <form
      action="/update-password"
      method="POST"
    >

      <div class="field">

        <label>
          Current Password
        </label>

        <input
          type="password"
          name="currentPassword"
          required
        />

      </div>


      <div class="field">

        <label>
          New Password
        </label>

        <input
          type="password"
          name="newPassword"
          required
        />

      </div>


      <div class="modal-actions">

        <button
          type="submit"
          class="btn btn-dark"
        >
          Update
        </button>

        <button
          type="button"
          class="btn btn-outline"
          onclick="closePasswordModal()"
        >
          Cancel
        </button>

      </div>

    </form>

  </div>

</div>


<!-- =======================
     DELETE ACCOUNT MODAL
======================== -->

<div
  id="deleteModal"
  class="modal-backdrop"
>

  <div class="modal-card">

    <h2>
      Delete Account
    </h2>

    <p class="modal-warn">
      This action cannot be undone.
    </p>


    <form
      action="/delete-account"
      method="POST"
    >

      <div class="field">

        <label>
          Enter your password to confirm
        </label>

        <input
          type="password"
          name="password"
          required
        />

      </div>


      <div class="modal-actions">

        <button
          type="submit"
          class="btn btn-danger"
        >
          Delete Account
        </button>

        <button
          type="button"
          class="btn btn-outline"
          onclick="closeDeleteModal()"
        >
          Cancel
        </button>

      </div>

    </form>

  </div>

</div>


<!-- =======================
     JAVASCRIPT
======================== -->

<script>

  function openPasswordModal() {
    document.getElementById("passwordModal").style.display = "flex";
  }

  function closePasswordModal() {
    document.getElementById("passwordModal").style.display = "none";
  }

  function openDeleteModal() {
    document.getElementById("deleteModal").style.display = "flex";
  }

  function closeDeleteModal() {
    document.getElementById("deleteModal").style.display = "none";
  }

</script>


  </body>
</html>
