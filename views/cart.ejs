<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crate — Your cart</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --pine: #1f3a2e;
        --pine-dark: #14261d;
        --paper: #f2f5ef;
        --card: #ffffff;
        --ink: #1c231d;
        --ink-soft: #5c6b5e;
        --line: #dee4d9;
        --ember: #e4572e;
        --ember-dark: #c1431e;
        --brick: #a83a2e;
        --shadow-sm: 0 1px 2px rgba(20, 43, 33, 0.06);
        --radius: 12px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Inter", -apple-system, sans-serif;
        background: var(--paper);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        font-family: "Fraunces", serif;
        color: var(--pine-dark);
        margin: 0;
      }

      a {
        color: inherit;
      }

      /* Navbar */
      .navbar {
        background: var(--card);
        border-bottom: 1px solid var(--line);
        position: sticky;
        top: 0;
        z-index: 20;
      }

      .navbar-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--pine);
        color: #fff;
      }

      .brand-word {
        font-family: "Fraunces", serif;
        font-weight: 700;
        font-size: 21px;
        color: var(--pine-dark);
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: "Inter", sans-serif;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 18px;
        border-radius: 8px;
        border: 1.5px solid transparent;
        cursor: pointer;
        text-decoration: none;
        line-height: 1;
        white-space: nowrap;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
      }

      .btn:active {
        transform: translateY(1px);
      }

      .btn-sm {
        padding: 8px 14px;
        font-size: 13px;
      }

      .btn-primary {
        background: var(--ember);
        color: #fff;
      }

      .btn-primary:hover {
        background: var(--ember-dark);
      }

      .btn-outline {
        background: transparent;
        border-color: var(--line);
        color: var(--pine-dark);
      }

      .btn-outline:hover {
        border-color: var(--pine);
        background: var(--paper);
      }

      /* Page */
      .page {
        max-width: 760px;
        margin: 0 auto;
        padding: 40px 24px 72px;
      }

      .page-head {
        margin-bottom: 28px;
      }

      .eyebrow {
        font-family: "IBM Plex Mono", monospace;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ember-dark);
        margin: 0 0 8px;
      }

      .page-head h1 {
        font-size: 30px;
        font-weight: 600;
      }

      /* Empty state */
      .empty-state {
        background: var(--card);
        border: 1px dashed var(--line);
        border-radius: var(--radius);
        padding: 56px 24px;
        text-align: center;
      }

      .empty-state h2 {
        font-size: 22px;
        margin-bottom: 8px;
      }

      .empty-state p {
        color: var(--ink-soft);
        margin: 0 0 20px;
      }

      /* Receipt */
      .receipt {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
      }

      .receipt-header {
        background: var(--pine);
        color: rgba(255, 255, 255, 0.85);
        display: flex;
        justify-content: space-between;
        padding: 14px 24px;
        font-family: "IBM Plex Mono", monospace;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .receipt-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 20px 24px;
        border-bottom: 1px dashed var(--line);
      }

      .receipt-item:last-of-type {
        border-bottom: none;
      }

      .receipt-item-info h3 {
        font-size: 16px;
        margin-bottom: 4px;
      }

      .receipt-item-desc {
        color: var(--ink-soft);
        font-size: 13.5px;
        margin: 0 0 6px;
      }

      .receipt-item-meta {
        font-family: "IBM Plex Mono", monospace;
        font-size: 13px;
        color: var(--ink-soft);
        margin: 0;
      }

      .receipt-item-actions {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-shrink: 0;
      }

      .receipt-item-total {
        font-family: "IBM Plex Mono", monospace;
        font-weight: 600;
        font-size: 16px;
        color: var(--pine-dark);
        min-width: 64px;
        text-align: right;
      }

      .btn-icon-danger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1.5px solid var(--line);
        background: transparent;
        color: var(--ink-soft);
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .btn-icon-danger:hover {
        border-color: var(--brick);
        color: var(--brick);
        background: #fbedea;
      }

      .receipt-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        background: var(--paper);
        font-family: "IBM Plex Mono", monospace;
        font-weight: 700;
        font-size: 18px;
        color: var(--pine-dark);
      }
    </style>
  </head>

  <body>
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <span class="brand-mark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 9L5 4H19L21 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M3 9H21L19.5 20H4.5L3 9Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M8 9V4M12 9V4M16 9V4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="brand-word">Crate</span>
        </div>

        <a href="/dashboard" class="btn btn-outline btn-sm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Continue Shopping
        </a>
      </div>
    </header>

    <main class="page">
      <div class="page-head">
        <p class="eyebrow">Order summary</p>
        <h1><%= user.name %>'s cart</h1>
      </div>

      <% if (cartItems.length === 0) { %>
        <div class="empty-state">
          <h2>Your crate is empty</h2>
          <p>Head back to the shelves and add something you'll love.</p>
          <a href="/dashboard" class="btn btn-primary">Browse products</a>
        </div>
      <% } else { %>
        <% let grandTotal = 0; %>
        <div class="receipt">
          <div class="receipt-header">
            <span>Item</span>
            <span>Total</span>
          </div>

          <% cartItems.forEach((item) => { %>
            <% const lineTotal = item.product_price * item.quantity; grandTotal += lineTotal; %>
            <div class="receipt-item">
              <div class="receipt-item-info">
                <h3><%= item.product_name %></h3>
                <p class="receipt-item-desc"><%= item.description %></p>
                <p class="receipt-item-meta">₹<%= item.product_price %> × <%= item.quantity %></p>
              </div>

              <div class="receipt-item-actions">
                <span class="receipt-item-total">₹<%= lineTotal %></span>

                <form action="/cart/delete" method="POST">
                  <input type="hidden" name="productId" value="<%= item.product_id %>" />
                  <button type="submit" class="btn-icon-danger" aria-label="Remove item">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 7H20M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-8 0l1 13a2 2 0 002 2h4a2 2 0 002-2l1-13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                </form>
              </div>
            </div>
          <% }) %>

          <div class="receipt-total">
            <span>Total</span>
            <span>₹<%= grandTotal %></span>
          </div>
        </div>
      <% } %>
    </main>
  </body>
</html>
